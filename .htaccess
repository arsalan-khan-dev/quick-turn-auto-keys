<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS and non-www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://auttokeys.com/$1 [L,R=301,NE]

    # 2. Redirect /index.html to the root directory (/)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)index\.html\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ https://auttokeys.com/$1 [R=301,L]

    # 3. Redirect URLs with a trailing slash to their .html counterpart
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)/$ https://auttokeys.com/$1.html [R=301,L]

    # 4. Redirect extension-less URLs to their .html counterpart
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)$ https://auttokeys.com/$1.html [R=301,L]

</IfModule>
